---
import Layout from "@/layouts/Layout.astro";
import { brand } from "@/data/brand";
---

<Layout title={`404 - Página no encontrada | ${brand.name}`}>
  <main class="not-found-wrapper">
    <div class="not-found-card">
      <a href="/" class="brand-link" title={`Ir al inicio de ${brand.name}`}>
        <img
          src={brand.assets.logo}
          alt={brand.name}
          class="brand-logo"
          width="96"
          height="96"
        />
      </a>

      <div class="badge">Error 404</div>

      <h1 class="error-code">404</h1>

      <h2 class="error-title">Página no encontrada</h2>

      <p class="error-message">
        Parece que te has perdido. El enlace que buscas no existe o fue movido.
      </p>

      <div class="actions">
        <a href="/" class="btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Volver al Menú
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .not-found-wrapper {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background-color: var(--color-background, #222222);
    color: var(--color-text, #eeece4);
    box-sizing: border-box;
  }

  .not-found-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 440px;
    width: 100%;
    padding: 2.5rem 2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.5rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  }

  .brand-link {
    display: inline-block;
    margin-bottom: 1.25rem;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .brand-link:hover {
    transform: scale(1.05);
    opacity: 0.95;
  }

  .brand-logo {
    background: var(--color-primary);
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary, #f9aa0b);
    background: rgba(249, 170, 11, 0.12);
    border: 1px solid rgba(249, 170, 11, 0.3);
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .error-code {
    font-size: clamp(4.5rem, 12vw, 6.5rem);
    font-weight: 900;
    line-height: 1;
    margin: 0 0 0.5rem;
    letter-spacing: -0.04em;
    color: var(--color-secondary, #f9aa0b);
    text-shadow: 0 0 30px rgba(249, 170, 11, 0.2);
  }

  .error-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--color-text, #eeece4);
  }

  .error-message {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(238, 236, 228, 0.7);
    margin: 0 0 1.75rem;
    max-width: 340px;
  }

  .actions {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-secondary, #f9aa0b);
    color: #222222;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(249, 170, 11, 0.3);
  }

  .btn-primary:hover {
    background-color: #ffb72b;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(249, 170, 11, 0.4);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    .not-found-card {
      padding: 2rem 1.25rem;
      border-radius: 1.25rem;
    }

    .brand-logo {
      width: 70px;
      height: 70px;
    }

    .error-title {
      font-size: 1.2rem;
    }
  }
</style>
